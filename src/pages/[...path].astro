---
import KpLayout from '../layouts/KpLayout.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { getPage, getJobs, getSiteSettings } from '../lib/cms';
const rawPath = Astro.params.path ? `/${Astro.params.path}` : '/';
const cleanPath = rawPath.endsWith('/') ? rawPath : `${rawPath}/`;
const cmsPath = cleanPath === '/' ? '/home/' : (cleanPath.startsWith('/home/') ? cleanPath : `/home${cleanPath}`);
let page: any = null; let error = ''; let jobs: any[] = []; let settings: any = {};
try { page = await getPage(cmsPath); settings = await getSiteSettings(); if (cleanPath === '/projekte/' || page?.type === 'content.JobsIndexPage') { const jobQuery = Astro.url.searchParams.toString(); const result: any = await getJobs(jobQuery); jobs = Array.isArray(result) ? result : (Array.isArray(result?.data) ? result.data : []); } } catch (exception) { error = exception instanceof Error ? exception.message : 'CMS nicht erreichbar'; }
const fields = page?.fields || {}; const type = page?.type || ''; const html = (value: unknown) => typeof value === 'string' ? value : ''; const stream = (value: unknown) => Array.isArray(value) ? value : []; const val = (item: any) => item?.value || {}; const snippet = (item: any, key: string) => val(item)?.[key] || {}; const linkUrl = (item: any) => val(item)?.page?.url_path || val(item)?.external_url || '#'; const linkLabel = (item: any) => val(item)?.label || ''; const imageUrl = (image: any) => image?.url || image?.src || image?.rendition || ''; const serviceItems = stream(fields.services).map((item: any) => snippet(item, 'service')).filter((item: any) => item?.title); const testimonialItems = stream(fields.testimonials).map((item: any) => snippet(item, 'testimonial')).filter((item: any) => item?.quote); const teamItems = stream(fields.team_members).map((item: any) => snippet(item, 'team_member')).filter((item: any) => item?.name); const pageHeading = fields.hero_heading || fields.page_heading || page?.title || 'Kastell Personalberatung'; const isJob = type === 'content.JobPage'; const isJobsIndex = type === 'content.JobsIndexPage'; const isEmployer = type === 'content.EmployerPage'; const isCandidate = type === 'content.CandidatePage'; const showHero = !isJob && !isJobsIndex && (!isCandidate || fields.show_hero); const calendlyUrl = settings?.calendly_url || '/kontakt/';
const showTestimonialContent = fields.show_testimonial_content === true;
---
<KpLayout title={page?.title || 'Kastell Personalberatung'} description={page?.seo?.description || ''}>
{error ? <section class="state"><h1>Inhalt vorübergehend nicht verfügbar</h1><p>Der CMS-Dienst konnte nicht erreicht werden.</p></section> : page ? <article class={`cms-page cms-page--${type.replace('.', '-')}`}>
{showHero && <header class="page-hero" style={fields.hero_background_image ? `background-image:linear-gradient(90deg,rgba(1,43,40,.9),rgba(1,43,40,.58)),url('${imageUrl(fields.hero_background_image)}')` : undefined}><div class="page-hero__inner">{fields.hero_eyebrow && <p class="eyebrow">{fields.hero_eyebrow}</p>}<h1>{pageHeading}</h1>{fields.hero_text && <div class="rich rich--light" set:html={html(fields.hero_text)} />}{stream(fields.hero_ctas).length > 0 && <div class="actions">{stream(fields.hero_ctas).map((item: any) => <a class="button" href={linkUrl(item)}>{linkLabel(item)}</a>)}</div>}</div></header>}
{fields.intro_heading && <section class="section section--intro"><div class="section__inner"><h2>{fields.intro_heading}</h2>{fields.intro_body && <div class="rich" set:html={html(fields.intro_body)} />}</div></section>}
{fields.intro && <section class="section section--intro"><div class="section__inner"><div class="rich" set:html={html(fields.intro)} /></div></section>}{fields.introduction && <section class="section section--intro"><div class="section__inner"><div class="rich" set:html={html(fields.introduction)} /></div></section>}
{type === 'content.AboutPage' && fields.who_we_are_heading && <section class="section about-intro"><div class="section__inner"><h2>{fields.who_we_are_heading}</h2><div class="about-intro__copy">{stream(fields.who_we_are_sections).map((item: any) => <div class="rich">{val(item).heading && <h3>{val(item).heading}</h3>}{val(item).body && <div set:html={html(val(item).body)} />}</div>)}</div></div></section>}
{serviceItems.length > 0 && <section class="section services"><div class="section__inner section-heading"><p class="eyebrow">{fields.services_eyebrow || 'Leistungen'}</p><h2>{fields.services_heading || fields.intro_heading || pageHeading}</h2></div><div class="section__inner service-grid">{serviceItems.map((item: any) => <article class="service-card"><div class="service-card__icon"><ServiceIcon name={item.icon_identifier} /></div><h3>{item.title}</h3><p>{item.short_description || ''}</p>{item.detail_page?.url_path && <a href={item.detail_page.url_path.replace('/home/', '/')}>Mehr erfahren</a>}</article>)}</div></section>}
{stream(fields.why_kastell).length > 0 && <section class="section section--soft why"><div class="section__inner section-heading"><p class="eyebrow">{fields.why_eyebrow || ''}</p><h2>{fields.why_heading || ''}</h2></div><div class="section__inner why-grid">{stream(fields.why_kastell).map((item: any) => <article class="why-item">{imageUrl(val(item).image) && <img src={imageUrl(val(item).image)} alt="" loading="lazy" />}{val(item).heading && <h3>{val(item).heading}</h3>}{val(item).body && <div class="rich" set:html={html(val(item).body)} />}</article>)}</div></section>}
{stream(fields.statistics).length > 0 && <section class="section stats"><div class="section__inner stats-grid">{stream(fields.statistics).map((item: any) => <div class="stat"><strong>{val(item).value || ''}</strong><span>{val(item).label || ''}</span></div>)}</div></section>}
{teamItems.length > 0 && <section class="section team"><div class="section__inner"><p class="eyebrow">{fields.team_eyebrow || 'Das Beraterteam'}</p><h2>{fields.team_heading || 'Köpfe, die den Markt kennen.'}</h2>{fields.team_lead && <div class="team-lead rich" set:html={html(fields.team_lead)} />}<div class="team-grid">{teamItems.map((item: any, index: number) => { const portrait = item.image || item.portrait; const biography = item.bio || item.biography; return <article class={`team-card ${index % 2 ? 'team-card--reverse' : ''}`}>{imageUrl(portrait) && <img src={imageUrl(portrait)} alt={item.name} loading="lazy" />}<div><p class="team-index">{String(index + 1).padStart(2, '0')}</p><h3>{item.name}</h3><p class="role">{item.role || ''}</p>{biography && <div class="rich" set:html={html(biography)} />}{stream(item.expertise_tags).length > 0 && <div class="team-tags">{stream(item.expertise_tags).map((tag: any) => <span>{val(tag) || tag}</span>)}</div>}</div></article>})}</div></div></section>}
{(fields.testimonials_eyebrow || fields.testimonials_background_image || testimonialItems.length > 0) && <section class="section testimonials" data-show-content={showTestimonialContent ? 'true' : 'false'} style={fields.testimonials_background_image ? `background-image:linear-gradient(90deg,rgba(48,51,58,.88),rgba(48,51,58,.58)),url('${imageUrl(fields.testimonials_background_image)}')` : undefined}><div class="section__inner"><p class="eyebrow">{fields.testimonials_eyebrow || 'Stimmen aus unserem Netzwerk'}</p>{showTestimonialContent && <div class="testimonial-grid">{testimonialItems.map((item: any) => <blockquote><p>“{item.quote}”</p><footer>{item.person_label || ''}{item.organization ? ` · ${item.organization}` : ''}</footer></blockquote>)}</div>}<div class="testimonial-controls" aria-label="Kundenstimmen Navigation"><button type="button" aria-label="Vorherige Kundenstimme">←</button><button type="button" aria-label="Nächste Kundenstimme">→</button></div></div></section>}
{isCandidate && (fields.career_heading || fields.career_copy) && <section class="section candidate-career"><div class="section__inner candidate-career__grid">{imageUrl(fields.career_image) && <img src={imageUrl(fields.career_image)} alt="Kandidat:innen im Gespräch" loading="lazy" />}<div><h2>{fields.career_heading}</h2>{fields.career_copy && <div class="rich" set:html={html(fields.career_copy)} />}<a class="button button--dark" href="mailto:kontakt@kastellpersonalberatung.com">Unser Kandidaten-Netzwerk</a></div></div></section>}
{isCandidate && (fields.contact_heading || fields.contact_details) && <section class="section candidate-contact" style={fields.contact_background_image ? `background-image:linear-gradient(rgba(1,30,28,.76),rgba(1,43,40,.82)),url('${imageUrl(fields.contact_background_image)}')` : undefined}><div class="section__inner"><h2>{fields.contact_heading}</h2>{fields.contact_details && <div class="rich rich--light" set:html={html(fields.contact_details)} />}</div></section>}
{fields.recruitment_region_heading && <section class="section regions"><div class="section__inner region-grid">{imageUrl(fields.recruitment_region_image) && <img src={imageUrl(fields.recruitment_region_image)} alt="Deutschlandkarte mit Rekrutierungsregionen" loading="lazy" />}<div><p class="eyebrow">Unser Markt</p><h2>{fields.recruitment_region_heading}</h2>{fields.recruitment_region_copy && <div class="rich" set:html={html(fields.recruitment_region_copy)} />}<h3>Regionen, in denen wir besetzen</h3><div class="tags">{stream(fields.recruitment_regions).map((item: any) => <span>{item.value || item}</span>)}</div></div></div></section>}
{stream(fields.packages).length > 0 && <section class="section packages"><div class="section__inner"><p class="eyebrow">Bewerbungsunterlagen</p><h2>{pageHeading}</h2><div class="package-grid">{stream(fields.packages).map((item: any) => <article class="package-card"><h3>{val(item).name || ''}</h3><strong>{val(item).price_display || ''}</strong>{val(item).experience_level && <p>{val(item).experience_level}</p>}<div class="rich" set:html={html(val(item).description)} />{val(item).cta_label && <a class="button button--dark" href={val(item).cta_url || '#'}>{val(item).cta_label}</a>}</article>)}</div></div></section>}
{fields.how_it_works_heading && <section class="section section--soft"><div class="section__inner"><h2>{fields.how_it_works_heading}</h2>{fields.how_it_works_intro && <div class="rich" set:html={html(fields.how_it_works_intro)} />}<div class="steps">{stream(fields.how_it_works_steps).map((item: any, index: number) => <article><b>{String(index + 1).padStart(2, '0')}</b><h3>{val(item).heading || ''}</h3><div class="rich" set:html={html(val(item).text)} /></article>)}</div></div></section>}
{type === 'content.ContactPage' && <section class="section contact"><div class="section__inner"><h2>{fields.page_heading || 'Kontakt'}</h2>{Array.isArray(settings.offices) && <div class="office-grid">{settings.offices.map((item: any) => <article><h3>{item.value?.label || ''}</h3><p>{item.value?.street || ''}<br />{item.value?.postal_code || ''} {item.value?.city || ''}</p><a href={`mailto:${item.value?.email || ''}`}>{item.value?.email || ''}</a></article>)}</div>}{fields.website_url && <a class="button" href={fields.website_url}>{fields.website_url_label || fields.website_url}</a>}</div></section>}
{type === 'content.JobsIndexPage' && <><header class="jobs-hero"><div class="section__inner"><p class="eyebrow">{fields.hero_eyebrow || 'Projekte'}</p><h1>{fields.hero_heading || 'Aktuelle Projekte'}</h1>{fields.hero_intro && <div class="rich rich--light" set:html={html(fields.hero_intro)} />}</div></header><section class="section jobs"><div class="section__inner"><form class="job-filters" method="get"><label>{fields.search_label || 'Suche'}<input name="q" placeholder={fields.search_placeholder || 'Stellenbezeichnung oder Stichwort'} value={Astro.url.searchParams.get('q') || ''} /></label><label>{fields.location_filter_label || 'Standort'}<input name="location" placeholder="z. B. München" value={Astro.url.searchParams.get('location') || ''} /></label><label>{fields.category_filter_label || 'Kategorie'}<input name="category" placeholder="z. B. SAP" value={Astro.url.searchParams.get('category') || ''} /></label><label class="job-filter-check"><input type="checkbox" name="remote" value="true" checked={Astro.url.searchParams.get('remote') === 'true'} /> {fields.remote_filter_label || 'Remote möglich'}</label><button class="button button--dark" type="submit">Suchen</button><a class="job-reset" href="/projekte/">Zurücksetzen</a></form><p class="job-count">{jobs.length ? `${jobs.length} ${jobs.length === 1 ? 'Projekt' : 'Projekte'}` : (fields.empty_state_text || 'Keine passenden Projekte gefunden.')}</p><div class="jobs-list">{jobs.map((job: any) => <a class="job-card" href={`/projekte/${job.slug}/`}><div><p class="eyebrow">{job.fields?.category || 'Projekt'}</p><h2>{job.title}</h2><p>{job.fields?.location_display || ''} {job.fields?.remote ? '· Remote' : ''}</p></div><span>Details&nbsp; →</span></a>)}</div></div></section></>}
{isJob && <section class="section job-detail"><div class="section__inner"><p class="eyebrow">{fields.category || 'Projekt'}{fields.location_display ? ` · ${fields.location_display}` : ''}</p><h1>{page.title}</h1>{fields.summary && <div class="rich" set:html={html(fields.summary)} />}{(fields.specialization || fields.experience_display || fields.employment_type) && <div class="job-meta">{fields.specialization && <span><b>Schwerpunkt</b>{fields.specialization}</span>}{fields.experience_display && <span><b>Erfahrung</b>{fields.experience_display}</span>}{fields.employment_type && <span><b>Beschäftigung</b>{fields.employment_type}</span>}</div>}{stream(fields.responsibilities).length > 0 && <><h2>Aufgaben</h2><ul>{stream(fields.responsibilities).map((item: any) => <li class="rich" set:html={html(item.value)} />)}</ul></>}{stream(fields.candidate_profile).length > 0 && <><h2>Ihr Profil</h2><ul>{stream(fields.candidate_profile).map((item: any) => <li class="rich" set:html={html(item.value)} />)}</ul></>}{stream(fields.benefits).length > 0 && <><h2>Ihre Vorteile</h2><ul>{stream(fields.benefits).map((item: any) => <li class="rich" set:html={html(item.value)} />)}</ul></>}{fields.application_email && <a class="button button--dark" href={`mailto:${fields.application_email}`}>Bewerbung senden</a>}</div></section>}
{isEmployer && fields.closing_heading && <section class="section closing closing--employer" style={fields.closing_background_image ? `background-image:linear-gradient(rgba(1,43,40,.74),rgba(1,43,40,.8)),url('${imageUrl(fields.closing_background_image)}')` : undefined}><div class="section__inner"><p class="eyebrow">{fields.closing_eyebrow || ''}</p><h2>{fields.closing_heading}</h2>{fields.closing_copy && <div class="rich rich--light" set:html={html(fields.closing_copy)} />}<a class="button button--light" href={calendlyUrl}>{fields.calendly_cta_label || 'Termin vereinbaren'}</a></div></section>}
{!isEmployer && (stream(fields.closing_cta).length > 0 || stream(fields.contact_cta).length > 0) && <section class="section closing"><div class="section__inner">{[...stream(fields.closing_cta), ...stream(fields.contact_cta)].map((item: any) => <a class="button button--light" href={linkUrl(item)}>{linkLabel(item)}</a>)}</div></section>}{fields.body && <section class="section legal"><div class="section__inner"><div class="rich" set:html={html(fields.intro)} /><div class="rich" set:html={html(fields.body)} /></div></section>}
</article> : <section class="state"><h1>Seite nicht gefunden</h1></section>}
</KpLayout>
<style>
:global(body){background:#fff;color:#012b28}.cms-page{font-family:'Nunito',sans-serif}.section__inner,.page-hero__inner{width:min(1160px,calc(100% - 48px));margin:0 auto}.page-hero{min-height:390px;display:flex;align-items:center;background:#012b28 center/cover no-repeat;color:#fff}.page-hero__inner{padding:72px 0}.page-hero h1{max-width:980px;margin:.25rem 0 1.25rem;font-size:clamp(2.8rem,6vw,5.8rem);line-height:1.04;letter-spacing:.01em}.eyebrow{margin:0 0 1rem;color:#012b28;font-size:.8rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.page-hero .eyebrow{color:#8fd0c1}.section{padding:88px 0}.section--intro{background:#fff}.section--soft{background:#f5f6f9}.section h2{max-width:850px;margin:0 0 2rem;color:#012b28;font-size:clamp(2rem,4vw,3.7rem);line-height:1.08}.rich{color:#4d5d5b;font-size:1.05rem;line-height:1.75}.rich--light{max-width:760px;color:rgba(255,255,255,.84)}.actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:2rem}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 2rem;border:1px solid #8fd0c1;border-radius:55px;background:transparent;color:#fff;font-weight:700;text-decoration:none}.button:hover{background:#e3c88f;border-color:#e3c88f;color:#012b28}.button--dark{border-color:#012b28;background:#012b28}.button--light{border-color:#fff}.service-grid,.team-grid,.testimonial-grid,.package-grid,.office-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.service-card,.package-card{padding:30px;border:1px solid #dce7e3;background:#fff}.service-card__icon{color:#012b28;font-size:1.6rem}.service-card h3,.package-card h3,.team-card h3{margin:.8rem 0 .5rem;color:#012b28}.service-card a{color:#012b28;font-weight:700}.stats{background:#e9eef4}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.stat{padding:28px;background:#fff}.stat strong{display:block;color:#012b28;font-size:clamp(2.2rem,4vw,3.4rem);line-height:1}.stat span{display:block;margin-top:12px;color:#6b6f78}.team{background:#012b28;color:#fff}.team .eyebrow,.team h2{color:#fff}.team-grid{grid-template-columns:repeat(3,1fr)}.team-card{overflow:hidden;background:#01201d}.team-card img{width:100%;aspect-ratio:4/5;object-fit:cover}.team-card>div{padding:22px}.team-card h3{color:#fff}.role{color:#8fd0c1}.team .rich{color:rgba(255,255,255,.78);font-size:.95rem}.testimonial-grid{grid-template-columns:repeat(2,1fr)}blockquote{margin:0;padding:28px;background:#012b28;color:#fff}blockquote p{font-size:1.15rem;line-height:1.65}blockquote footer{font-weight:700;color:#e3c88f}.tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.tags span{padding:.5rem 1rem;border:1px solid #8fd0c1;border-radius:30px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.steps article{padding:25px;background:#fff}.steps b{color:#e3c88f;font-size:2rem}.office-grid{grid-template-columns:repeat(3,1fr)}.office-grid article{padding:24px;background:#f5f6f9}.office-grid h3{color:#012b28}.office-grid a{color:#012b28}.jobs-list{display:grid;gap:14px}.job-card{display:block;padding:22px 26px;border:1px solid #dce7e3;color:#012b28;text-decoration:none}.job-card:hover{border-color:#8fd0c1}.job-card h3{margin:0 0 6px}.job-card p{margin:0;color:#6b6f78}.job-card span{display:block;margin-top:8px;font-size:.85rem;font-weight:700}.closing{background:#012b28;text-align:center}.state{min-height:60vh;padding:100px 5vw}.state h1{color:#012b28}.job-detail .section__inner{max-width:900px}.job-detail h1{color:#012b28;font-size:clamp(2.5rem,6vw,5rem);line-height:1.05}.job-detail li{margin:.7rem 0}.legal{max-width:1000px;margin:auto}
@media(max-width:900px){.service-grid,.team-grid,.package-grid,.office-grid{grid-template-columns:repeat(2,1fr)}.stats-grid{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:1fr}.section{padding:64px 0}}@media(max-width:600px){.section__inner,.page-hero__inner{width:min(100% - 32px,1160px)}.page-hero{min-height:330px}.page-hero__inner{padding:52px 0}.service-grid,.team-grid,.testimonial-grid,.package-grid,.office-grid,.stats-grid{grid-template-columns:1fr}.section{padding:52px 0}.page-hero h1{font-size:clamp(2.3rem,12vw,4rem)}}
  .section-heading{text-align:center}.section-heading h2{margin-inline:auto;max-width:720px}.services{padding-top:80px;background:#fff}.service-grid{padding-top:4px}.service-card{position:relative;display:flex;min-height:290px;flex-direction:column;align-items:flex-start;gap:14px;overflow:hidden;padding:36px 32px 32px;border:0;border-radius:22px;background:linear-gradient(165deg,#fbfaf7 0%,#fff 60%);box-shadow:0 16px 44px rgba(1,43,40,.09);transition:transform .3s ease,box-shadow .3s ease}.service-card:hover{transform:translateY(-6px);box-shadow:0 28px 64px rgba(1,43,40,.16)}.service-card__icon{display:grid;width:56px;height:56px;place-items:center;border-radius:17px;background:#012b28;color:#8fd0c1}.service-card h3{font-size:1.25rem}.service-card p{flex:1;margin:0;color:#4a4e57;line-height:1.72}.service-card a{display:inline-block;padding:.62rem 1.25rem;border:1px solid rgba(1,43,40,.35);border-radius:40px;font-size:.8rem;letter-spacing:.04em;text-transform:uppercase}.why{padding-top:72px}.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;margin-top:10px}.why-item{text-align:center;padding:22px}.why-item img{width:112px;height:112px;object-fit:contain}.why-item h3{margin:18px 0 0;color:#012b28;font-size:1.08rem}.testimonials{color:#fff;background:#012b28 center/cover no-repeat}.testimonials .eyebrow{color:#8fd0c1;text-align:center}.testimonials blockquote{background:rgba(1,32,29,.76);border-radius:14px}.region-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;gap:72px}.region-grid>img{width:100%;height:auto}.region-grid h3{margin:2rem 0 1rem;color:#012b28}.closing--employer{min-height:520px;display:flex;align-items:center;background:#012b28 center/cover no-repeat}.closing--employer .section__inner{display:flex;flex-direction:column;align-items:center;text-align:center}.closing--employer .eyebrow{color:#e3c88f}.closing--employer h2{max-width:850px;margin-inline:auto;color:#fff}.closing--employer .rich{margin-bottom:1.5rem}
