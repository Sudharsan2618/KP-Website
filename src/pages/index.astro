---
import KpLayout from '../layouts/KpLayout.astro';
import { getPage, getSiteSettings } from '../lib/cms';

let page: any = null;
let settings: any = {};
let error = '';
try {
  page = await getPage('/home/');
  settings = await getSiteSettings();
} catch (exception) {
  error = exception instanceof Error ? exception.message : 'CMS nicht erreichbar';
}
const title = page?.title || 'Kastell Personalberatung';
const fields = page?.fields || {};
const chapters = Array.isArray(fields.hero_chapters) ? fields.hero_chapters : [];
const ctas = [...(Array.isArray(fields.employer_cta) ? fields.employer_cta : []), ...(Array.isArray(fields.candidate_cta) ? fields.candidate_cta : [])];
const siteName = settings.site_name || 'Kastell Personalberatung';
const brandWords = siteName.trim().split(/\s+/);
const brandPrimary = brandWords[0] || siteName;
const brandSecondary = brandWords.slice(1).join(' ');
const compactLogo = settings.compact_logo?.url || settings.full_logo?.url || '';
const heroSubtitle = chapters[0]?.value?.heading || title;
const heroTagline = chapters[1]?.value?.heading || '';
const heroDescription = chapters[1]?.value?.paragraph || chapters[0]?.value?.paragraph || '';
---

<KpLayout title={title} description={page?.seo?.description || ''} splash>
  {fields.intro_video_url && <div slot="splash" class="splash-screen"><video autoplay muted playsinline preload="auto" src={fields.intro_video_url} aria-label="Intro-Video von Kastell Personalberatung"></video></div>}
  <article>
    {error ? <p role="alert">{error}</p> : <>
      <section class="home-hero">
        <div class="home-hero__glow" aria-hidden="true"></div>
        <div class="home-hero__content">
          {compactLogo && <img class="home-hero__mark" src={compactLogo} alt="" aria-hidden="true" />}
          <h1><span>{brandPrimary.toUpperCase()}</span>{brandSecondary && <strong>{brandSecondary.toUpperCase()}</strong>}</h1>
          <div class="home-hero__rule" aria-hidden="true"></div>
          <p class="home-hero__tagline">{heroTagline}</p>
          <p class="home-hero__subtitle">{heroSubtitle}</p>
          {heroDescription && <div class="home-hero__description" set:html={heroDescription} />}
          <div class="home-ctas">{ctas.map((item: any) => <a class="cta" href={item.value?.page?.url_path?.replace(/^\/home(?=\/)/, '') || '#'}>{item.value?.label || ''}</a>)}</div>
        </div>
      </section>
      {chapters.slice(2).map((chapter: any) => <section class="home-chapter"><h2>{chapter.value?.heading || ''}</h2>{chapter.value?.paragraph && <div set:html={chapter.value.paragraph} />}</section>)}
    </>}
  </article>
</KpLayout>

<style>
  article { min-height: 75vh; }
  .home-hero { position: relative; overflow: hidden; min-height: calc(100vh - 110px); display: flex; align-items: center; justify-content: center; text-align: center; color: #fff; background: radial-gradient(1100px 620px at 50% 32%, rgba(227,200,143,.16), transparent 68%), linear-gradient(158deg,#023a34 0%,#012b28 46%,#001a17 78%,#001210 100%); }
  .home-hero__glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(760px 760px at 78% 78%, rgba(143,208,193,.08), transparent 70%), radial-gradient(620px 620px at 16% 22%, rgba(227,200,143,.10), transparent 72%); }
  .home-hero__content { position: relative; z-index: 1; width: min(900px, 94vw); padding: 2.75rem 1.5rem 2.5rem; }
  .home-hero__mark { display: block; width: 52px; height: 68px; margin: 0 auto 1.25rem; object-fit: contain; }
  h1 { margin: 0; color: #fff; font-size: clamp(2.6rem, 6vw, 6.5rem); font-weight: 800; line-height: .98; letter-spacing: .025em; }
  h1 span, h1 strong { display: block; }
  h1 strong { color: #e3c88f; font-weight: 800; letter-spacing: .015em; }
  .home-hero__rule { width: 7rem; height: 1px; margin: 1.35rem auto 1.15rem; background: #e3c88f; }
  .home-hero__tagline { margin: 0 0 .45rem; color: #fff; font-size: clamp(1.2rem, 1.8vw, 2rem); font-weight: 600; line-height: 1.3; }
  .home-hero__subtitle, .home-hero__description { max-width: 720px; margin: 0 auto 1.25rem; color: rgba(255,255,255,.82); font-size: clamp(1rem, 1.45vw, 1.35rem); line-height: 1.45; }
  .home-hero__description { margin-top: -.75rem; }
  .home-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.1rem; margin-top: 1.5rem; }
  .cta { display: inline-block; min-width: 18rem; padding: .78rem 2.35rem; color: #fff; border: 1px solid rgba(255,255,255,.5); border-radius: 55px; background: rgba(0,26,23,.25); font-weight: 600; font-size: 1rem; letter-spacing: .03em; text-decoration: none; transition: background .25s ease, color .25s ease, border-color .25s ease; }
  .cta:hover { color: #012b28; border-color: #e3c88f; background: #e3c88f; }
  .home-chapter { max-width: 900px; margin: 0 auto; padding: 5rem 5vw; }
  .home-chapter h2 { color: #012b28; font-size: clamp(2rem, 4vw, 4rem); }
  @media (max-width: 900px) { .home-hero { min-height: calc(100vh - 88px); } .home-hero__content { padding-top: 2.25rem; padding-bottom: 2rem; } h1 { font-size: clamp(2.5rem, 7vw, 5rem); } }
  @media (max-width: 600px) { .home-hero__mark { width: 44px; height: 58px; margin-bottom: 1rem; } h1 { font-size: clamp(2.25rem, 11vw, 4rem); letter-spacing: .01em; } h1 strong { letter-spacing: 0; } .home-hero__tagline { font-size: 1.18rem; } .cta { width: min(100%, 20rem); min-width: 0; } }
</style>
